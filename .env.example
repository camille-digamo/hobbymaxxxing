# =============================================================================
# YouTube Hobby Maxxxer Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file with real credentials to git!

# =============================================================================
# API KEYS & AUTHENTICATION
# =============================================================================

# YouTube Data API v3 key
# Get from: https://console.developers.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud project
YOUTUBE_API_KEY=your_youtube_api_key_here

# Anthropic API key
# Get from: https://console.anthropic.com/
# Used for Claude AI video recommendations and topic analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Discord bot token
# Create bot at: https://discord.com/developers/applications
# Copy token from Bot section (NOT the Client ID)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# =============================================================================
# DISCORD CONFIGURATION
# =============================================================================

# Discord channel ID where videos will be posted
# Right-click channel → Copy Channel ID (Developer Mode must be enabled)
# Enter as numbers only, no quotes
DISCORD_CHANNEL_ID=123456789012345678

# Your Discord user ID for feedback validation
# Right-click your profile → Copy User ID
# Only this user can give feedback that the bot will record
DISCORD_USER_ID=123456789012345678

# =============================================================================
# GOOGLE SHEETS INTEGRATION
# =============================================================================

# Google Sheets document ID
# From your sheet URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# Extract the long string between /d/ and /edit
GOOGLE_SHEETS_ID=your_google_sheets_document_id_here

# Google Service Account file path
# For local development: auth/hobbymaxxxing-service-account.json
# For GitHub Actions: handled automatically via secrets
# For Railway: upload via environment variables (see Railway setup guide)
GOOGLE_SERVICE_ACCOUNT_FILE=auth/hobbymaxxxing-service-account.json

# =============================================================================
# DEPLOYMENT-SPECIFIC NOTES
# =============================================================================

# LOCAL DEVELOPMENT:
# - Copy your service account JSON file to the project directory
# - Run: cp .env.example .env
# - Fill in all values above
# - Test with: python main.py --help

# GITHUB ACTIONS DEPLOYMENT:
# - Add all the above values as GitHub Secrets (Repository Settings → Secrets)
# - For GOOGLE_SERVICE_ACCOUNT_FILE: add the JSON content as GOOGLE_SERVICE_ACCOUNT_JSON secret
# - The workflow will create the file automatically

# RAILWAY DEPLOYMENT:
# - Add all the above as Railway environment variables
# - For Google Service Account: paste the entire JSON content as a single variable
# - Railway will handle file creation automatically

# RASPBERRY PI / LOCAL SERVER:
# - Install dependencies: pip install -r requirements.txt
# - Set up cron job: 0 9 * * * cd /path/to/project && python main.py --daily-job
# - Run listener service: python main.py --listen
# - Or use systemd service: sudo systemctl enable hobby-listener